{
  "name": "SIMATS - send password reset email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-password-reset-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c2a5d3b1-0001-4d2f-8e7b-6a3c8f1b2001",
      "name": "App asks for a reset email",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "8e2b7d14-3c6a-4f09-b5d1-2a7e9c4f0b22"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ /^[^@\\s]+@[^@\\s]+$/.test($json.body.to || '') }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ /^[A-Za-z0-9_-]{40,100}$/.test(String($json.body.token || '')) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c2a5d3b1-0002-4d2f-8e7b-6a3c8f1b2002",
      "name": "Address and token look right?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "PASTE-THE-MAIL-RELAY-WEB-APP-URL-HERE",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ kind: 'reset', to: $json.body.to, full_name: $json.body.full_name || '', token: String($json.body.token) }) }}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": true,
              "maxRedirects": 5
            }
          },
          "timeout": 20000
        }
      },
      "id": "c2a5d3b1-0003-4d2f-8e7b-6a3c8f1b2003",
      "name": "Mail relay sends the reset link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        -100
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "",
          "name": "SIMATS mail relay secret"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c3",
              "leftValue": "={{ $json.sent === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c2a5d3b1-0004-4d2f-8e7b-6a3c8f1b2004",
      "name": "Relay says sent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        -100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"sent\": true } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "c2a5d3b1-0005-4d2f-8e7b-6a3c8f1b2005",
      "name": "Tell the app it was sent",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        -200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"sent\": false, \"detail\": $json.detail || 'mail relay did not send' } }}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "c2a5d3b1-0006-4d2f-8e7b-6a3c8f1b2006",
      "name": "Tell the app it failed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"sent\": false, \"detail\": \"missing or malformed 'to' or 'token'\" } }}",
        "options": {
          "responseCode": 422
        }
      },
      "id": "c2a5d3b1-0007-4d2f-8e7b-6a3c8f1b2007",
      "name": "Refuse a malformed request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        480,
        100
      ]
    }
  ],
