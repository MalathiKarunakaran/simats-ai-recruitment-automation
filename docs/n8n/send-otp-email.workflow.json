{
  "name": "SIMATS - send login code email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-otp-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b1f4c2a0-0001-4c1e-9d6a-5f2b7e0a1001",
      "name": "App asks for a code email",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "5d0f6c3e-7a51-4b2f-9a1e-0c4d8b2e6f11"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ /^[^@\\s]+@[^@\\s]+$/.test($json.body.to || '') }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ /^\\d{6}$/.test(String($json.body.code || '')) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1f4c2a0-0002-4c1e-9d6a-5f2b7e0a1002",
      "name": "Address and code look right?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "PASTE-THE-MAIL-RELAY-WEB-APP-URL-HERE",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ kind: 'otp', to: $json.body.to, full_name: $json.body.full_name || '', code: String($json.body.code) }) }}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": true,
              "maxRedirects": 5
            }
          },
          "timeout": 20000
        }
      },
      "id": "b1f4c2a0-0003-4c1e-9d6a-5f2b7e0a1003",
      "name": "Mail relay sends the code",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        -100
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "",
          "name": "SIMATS mail relay secret"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c3",
              "leftValue": "={{ $json.sent === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1f4c2a0-0006-4c1e-9d6a-5f2b7e0a1006",
      "name": "Relay says sent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        -100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"sent\": true } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "b1f4c2a0-0004-4c1e-9d6a-5f2b7e0a1004",
      "name": "Tell the app it was sent",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        -200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"sent\": false, \"detail\": $json.detail || 'mail relay did not send' } }}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "b1f4c2a0-0007-4c1e-9d6a-5f2b7e0a1007",
      "name": "Tell the app it failed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"sent\": false, \"detail\": \"missing or malformed 'to' or 'code'\" } }}",
        "options": {
          "responseCode": 422
        }
      },
      "id": "b1f4c2a0-0005-4c1e-9d6a-5f2b7e0a1005",
      "name": "Refuse a malformed request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        480,
        100
      ]
    }
  ],
  "connections": {
