{
  "name": "SIMATS - send login code email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-otp-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b1f4c2a0-0001-4c1e-9d6a-5f2b7e0a1001",
      "name": "App asks for a code email",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "5d0f6c3e-7a51-4b2f-9a1e-0c4d8b2e6f11"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ /^[^@\\s]+@[^@\\s]+$/.test($json.body.to || '') }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            },
            {
              "id": "c2",
              "leftValue": "={{ /^\\d{6}$/.test(String($json.body.code || '')) }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1f4c2a0-0002-4c1e-9d6a-5f2b7e0a1002",
      "name": "Address and code look right?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "fromEmail": "SIMATS Recruitment <CHANGE-ME@saveetha.com>",
        "toEmail": "={{ $json.body.to }}",
        "subject": "Your SIMATS Recruitment sign-in code: {{ $json.body.code }}",
        "emailFormat": "both",
        "text": "=Hello {{ $json.body.full_name || '' }},\n\nYour sign-in code for SIMATS Recruitment is:\n\n    {{ $json.body.code }}\n\nIt works once and expires in 10 minutes.\n\nIf you did not try to sign in, you can ignore this email; nobody can sign in without the code.\n\nSIMATS Recruitment\nhttps://app.malathi.io",
        "html": "=<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:15px;color:#1f2937;line-height:1.5\"><p>Hello {{ $json.body.full_name || '' }},</p><p>Your sign-in code for <strong>SIMATS Recruitment</strong> is:</p><p style=\"font-size:28px;font-weight:bold;letter-spacing:6px;margin:16px 0\">{{ $json.body.code }}</p><p>It works once and expires in <strong>10 minutes</strong>.</p><p style=\"color:#6b7280;font-size:13px\">If you did not try to sign in, you can ignore this email; nobody can sign in without the code.</p><p style=\"color:#6b7280;font-size:13px\">SIMATS Recruitment &middot; <a href=\"https://app.malathi.io\">app.malathi.io</a></p></div>",
        "options": { "appendAttribution": false }
      },
      "id": "b1f4c2a0-0003-4c1e-9d6a-5f2b7e0a1003",
      "name": "Send the code",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [480, -100],
      "credentials": { "smtp": { "id": "", "name": "SIMATS mailbox (SMTP)" } }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"sent\": true } }}",
        "options": { "responseCode": 200 }
      },
      "id": "b1f4c2a0-0004-4c1e-9d6a-5f2b7e0a1004",
      "name": "Tell the app it was sent",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, -100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"sent\": false, \"detail\": \"missing or malformed 'to' or 'code'\" } }}",
        "options": { "responseCode": 422 }
      },
      "id": "b1f4c2a0-0005-4c1e-9d6a-5f2b7e0a1005",
      "name": "Refuse a malformed request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 100]
    }
  ],
  "connections": {
    "App asks for a code email": { "main": [[{ "node": "Address and code look right?", "type": "main", "index": 0 }]] },
    "Address and code look right?": {
      "main": [
        [{ "node": "Send the code", "type": "main", "index": 0 }],
        [{ "node": "Refuse a malformed request", "type": "main", "index": 0 }]
      ]
    },
    "Send the code": { "main": [[{ "node": "Tell the app it was sent", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
