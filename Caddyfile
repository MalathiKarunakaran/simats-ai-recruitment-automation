# Reverse proxy / automatic HTTPS (Let's Encrypt) for the two public
# domains, per DEPLOYMENT.md section 6. api.malathi.io and app.malathi.io
# both already point at this VPS's IP in DNS.
#
# HTTPS-only (port 443): port 80 on this VPS is occupied by something
# outside this docker-compose project, so Caddy doesn't bind it at all
# (see docker-compose.yml). disable_http_challenge tells the ACME issuer
# to skip the HTTP-01 challenge (which needs port 80 reachable publicly)
# and use TLS-ALPN-01 instead, which only needs port 443 -- already
# Caddy's. Plain http:// requests to either domain won't work or redirect
# since nothing of ours listens on 80.
api.malathi.io {
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    reverse_proxy backend:8000
}

app.malathi.io {
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    reverse_proxy frontend:80
}
