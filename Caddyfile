# Reverse proxy / automatic HTTPS (Let's Encrypt) for the two public
# domains, per DEPLOYMENT.md section 6. api.malathi.io and app.malathi.io
# both already point at this VPS's IP in DNS -- Caddy issues/renews certs
# for whichever domains it's actually asked to serve, no manual cert
# management needed.
api.malathi.io {
    reverse_proxy backend:8000
}

app.malathi.io {
    reverse_proxy frontend:80
}
