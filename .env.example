# --- Postgres (used by docker-compose.yml AND the app via DATABASE_URL below) ---
POSTGRES_USER=simats_app
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=simats_recruitment

# --- App ---
# Local dev: host is localhost since Postgres runs in Docker with a published port.
# Port 5434, not the default 5432 -- this machine already runs other unrelated
# Postgres containers on 5432/5433 (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://simats_app:change_me_locally@localhost:5434/simats_recruitment

# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Seed script (app/db/seed.py) ---
# Set this to your own email to log in as Super Admin locally, e.g. malathi@saveetha.com
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
# Leave unset to auto-generate and print a one-time password at seed time
SEED_SUPER_ADMIN_PASSWORD=
# Shared password for sample/demo users seeded across roles/campuses (dev only, never use in prod)
SEED_SAMPLE_USER_PASSWORD=DevPass123!

# --- Anthropic (Module 14 "Hermes": assistant chat + daily briefing) ---
# Get a key from https://console.anthropic.com/ -- leave blank to run the app
# without live AI calls (the test suite mocks this and never needs a real key).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI (Phase 3: JD generation, resume scoring, interview questions) ---
# Get a key from https://platform.openai.com/ -- leave blank to run the app
# without live AI calls (the test suite mocks this and never needs a real key).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- MinIO (Phase 3: resume object storage) ---
MINIO_ROOT_USER=simats_minio
MINIO_ROOT_PASSWORD=change_me_locally
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=simats_minio
MINIO_SECRET_KEY=change_me_locally
MINIO_BUCKET_RESUMES=resumes
# --- MinIO (Phase F: Sanctioned Strength bulk-upload original files) ---
MINIO_BUCKET_BULK_UPLOADS=bulk-uploads
MINIO_USE_SSL=false

# --- ChromaDB (Phase 3: resume embeddings / semantic JD matching) ---
CHROMA_HOST=localhost
CHROMA_PORT=8012
CHROMA_COLLECTION_RESUMES=resume_embeddings

# --- n8n (Phase 6: notification delivery + job-portal distribution) ---
# Leave blank to run without real delivery -- notifications are recorded as
# FAILED with an explanatory error_message rather than silently faked, and
# POST /job-postings/{id}/distribute returns a clean 503. Point this at a
# real n8n instance's webhook base URL to enable real delivery.
N8N_BASE_URL=
N8N_TIMEOUT_SECONDS=5.0

# --- Public apply link base (Phase 6: Module 4 job ads / QR codes) ---
# Placeholder until a candidate portal (Module 5) / frontend exists.
PUBLIC_APPLY_BASE_URL=https://careers.simats.edu

# --- CORS (Phase 7; frontend/ added in the Frontend Foundation phase) ---
# Comma-separated origins, e.g. https://app.simats.edu,https://staging.simats.edu
# For local frontend dev against the Vite dev server: http://localhost:5173
# Leave blank to add no CORS middleware at all (same-origin-only).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Reverse-proxy trust. Comma-separated peer IPs/CIDRs whose X-Forwarded-For
# may be believed. Leave EMPTY for local dev (uvicorn faces the browser
# directly). In Docker the entrypoint derives the host gateway automatically
# when unset; set it only to override. Never "*".
TRUSTED_PROXY_IPS=

# development (default) | test | production. In production, OTP login codes
# and password-reset tokens are NEVER printed to the console; if N8N_BASE_URL
# is unset those endpoints return 503 and the login page offers password
# sign-in only. docker-compose.yml sets production for the backend.
ENVIRONMENT=development
# Interactive API docs (/docs, /redoc, /openapi.json). Leave unset: served
# everywhere except production. Set true/false to force either way.
# EXPOSE_API_DOCS=
